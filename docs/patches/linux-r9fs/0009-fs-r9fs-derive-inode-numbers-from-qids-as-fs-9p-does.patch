From ce42b3c71d53a1882d658a4954d39ab991c11124 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Thu, 8 Oct 2026 17:12:39 +0000
Subject: [PATCH 9/9] fs: r9fs: derive inode numbers from qids as fs/9p does

fs/9p uses qid.path + 2 as the inode number (QID2INO), so a server
that uses path 0 never yields inode 0, which readdir consumers treat
as a deleted entry. r9fs used qid.path unchanged, so st_ino and d_ino
differed from the C client for the same export and could be 0.

Use the same mapping for inode lookup and directory entries.
---
 fs/r9fs/proto.rs | 8 ++++++++
 fs/r9fs/r9fs.rs  | 4 ++--
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/fs/r9fs/proto.rs b/fs/r9fs/proto.rs
index 33060ea9c..50d442121 100644
--- a/fs/r9fs/proto.rs
+++ b/fs/r9fs/proto.rs
@@ -33,6 +33,14 @@ pub(crate) struct Qid {
     pub(crate) path: u64,
 }
 
+impl Qid {
+    /// Inode number for this file, as `fs/9p` computes it (`QID2INO` on 64-bit): servers may use
+    /// path 0, and readdir consumers skip entries whose inode number is 0.
+    pub(crate) fn ino(&self) -> u64 {
+        self.path.wrapping_add(2)
+    }
+}
+
 /// Writes a message body into a fixed-size buffer.
 pub(crate) struct Enc<'a> {
     buf: &'a mut [u8],
diff --git a/fs/r9fs/r9fs.rs b/fs/r9fs/r9fs.rs
index 993d02e05..cbb0cac38 100644
--- a/fs/r9fs/r9fs.rs
+++ b/fs/r9fs/r9fs.rs
@@ -119,7 +119,7 @@ fn make_inode(sb: &SuperBlock<R9fs>, fid: u32) -> Result<ARef<INode<R9fs>>> {
             return Err(e);
         }
     };
-    match sb.get_or_create_inode(attr.qid.path) {
+    match sb.get_or_create_inode(attr.qid.ino()) {
         Ok(Either::Existing(inode)) => {
             session.clunk(fid);
             Ok(inode)
@@ -268,7 +268,7 @@ fn read_dir(inode: &INode<Self>, file: &OpenFile, emitter: &mut DirEmitter) -> R
             let mut d = Dec::new(&buf[..n]);
             while d.remaining() > 0 {
                 let ent = Dirent::decode(&mut d)?;
-                if !emitter.emit(ent.name, ent.qid.path, ent.typ.into()) {
+                if !emitter.emit(ent.name, ent.qid.ino(), ent.typ.into()) {
                     return Ok(());
                 }
                 emitter.set_pos(i64::try_from(ent.offset).map_err(|_| EIO)?);
