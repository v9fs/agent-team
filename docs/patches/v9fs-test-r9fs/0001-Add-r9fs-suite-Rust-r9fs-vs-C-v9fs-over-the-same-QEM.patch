@@ -0,0 +1,31 @@
+#!/usr/bin/env bash
+# Build the arm64 Image plus r9fs.ko for the r9fs suite.
+#
+#   scripts/v9fs-build-r9fs-kernel <linux-src> [<out-dir>]
+#
+# Same 9p options as linux-kernel-publish.yml, plus CONFIG_RUST=y and CONFIG_R9FS_FS=m.
+# Needs clang/lld, rustc (rust-src component) and bindgen on the host: the
+# ghcr.io/v9fs/docker image does not carry a Rust toolchain. Output layout matches
+# KERNELBUILD (arch/arm64/boot/Image, fs/r9fs/r9fs.ko).
+set -euo pipefail
+
+src="${1:?usage: $0 <linux-src> [<out-dir>]}"
+out="${2:-$PWD/kernel/.build}"
+mk=(make -C "$src" O="$out" ARCH=arm64 LLVM=1)
+
+mkdir -p "$out"
+[ -f "$out/.config" ] || "${mk[@]}" defconfig
+"$src/scripts/config" --file "$out/.config" \
+  -e NET_9P -e NET_9P_FD -e NET_9P_VIRTIO -e 9P_FS \
+  -e 9P_FS_POSIX_ACL -e 9P_FS_SECURITY -e 9P_FS_XATTR \
+  -e FS_POSIX_ACL -e TMPFS_POSIX_ACL -e TMPFS_XATTR \
+  -e UNIX -e VIRTIO_PCI -e PCI \
+  -e IKCONFIG -e IKCONFIG_PROC \
+  -e RUST -m R9FS_FS
+"${mk[@]}" olddefconfig
+for opt in CONFIG_RUST=y CONFIG_R9FS_FS=m CONFIG_9P_FS=y CONFIG_NET_9P_VIRTIO=y; do
+  grep -qx "$opt" "$out/.config" || { echo "ERROR: $opt not set (make rustavailable?)"; exit 2; }
+done
+"${mk[@]}" -j"$(nproc)" Image
+"${mk[@]}" -j"$(nproc)" fs/r9fs/r9fs.ko
+ls -l "$out/arch/arm64/boot/Image" "$out/fs/r9fs/r9fs.ko"
