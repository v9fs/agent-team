new file mode 100644
index 0000000..b1c4de3
--- /dev/null
+++ b/scripts/v9fs-kmod.c
@@ -0,0 +1,39 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Minimal module loader for the guest chroot, which has no kmod.
+ *
+ *   v9fs-kmod load <file.ko> [params]
+ *   v9fs-kmod unload <name>
+ */
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+int main(int argc, char **argv)
+{
+	long rc;
+
+	if (argc >= 3 && !strcmp(argv[1], "load")) {
+		int fd = open(argv[2], O_RDONLY | O_CLOEXEC);
+
+		if (fd < 0) {
+			perror(argv[2]);
+			return 1;
+		}
+		rc = syscall(SYS_finit_module, fd, argc > 3 ? argv[3] : "", 0);
+		close(fd);
+	} else if (argc == 3 && !strcmp(argv[1], "unload")) {
+		rc = syscall(SYS_delete_module, argv[2], O_NONBLOCK);
+	} else {
+		fprintf(stderr, "usage: %s load <file.ko> [params] | unload <name>\n", argv[0]);
+		return 2;
+	}
+	if (rc) {
+		fprintf(stderr, "v9fs-kmod %s %s: %s\n", argv[1], argv[2], strerror(errno));
+		return 1;
+	}
+	return 0;
+}
diff --git a/scripts/v9fs-prepare-r9fs b/scripts/v9fs-prepare-r9fs
