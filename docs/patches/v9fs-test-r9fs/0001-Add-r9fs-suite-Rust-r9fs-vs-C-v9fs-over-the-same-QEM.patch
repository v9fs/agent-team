@@ -0,0 +1,42 @@
+#!/usr/bin/env bash
+# Host-side (container) preparation for the r9fs suite.
+#
+# - builds the v9fs-kmod module loader (the Debian chroot has no kmod);
+# - stages r9fs.ko from KERNELBUILD so the guest can load it;
+# - creates the export that QEMU serves on tags r9share and r9slow.
+#
+# The kernel under test must be built with CONFIG_RUST=y and CONFIG_R9FS_FS=m
+# (scripts/v9fs-build-r9fs-kernel).
+set -euo pipefail
+
+script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+KERNELBUILD="${KERNELBUILD:-/workspaces/kernel/.build}"
+out="${R9FS_TMP:-/workspaces/tmp/r9fs}"
+share="${R9FS_SHARE:-/workspaces/tmp/r9fs-share}"
+
+ko="${KERNELBUILD}/fs/r9fs/r9fs.ko"
+if [ ! -f "$ko" ]; then
+  echo "ERROR: $ko not found; build the kernel with scripts/v9fs-build-r9fs-kernel"
+  exit 2
+fi
+
+mkdir -p "$out"
+gcc -O2 -o "$out/v9fs-kmod" "${script_dir}/v9fs-kmod.c"
+cp -f "$ko" "$out/r9fs.ko"
+sha256sum "$out/r9fs.ko" | tee "$out/r9fs.ko.sha256"
+
+rm -rf "$share"
+mkdir -p "$share/sub" "$share/many"
+cd "$share"
+printf 'hello r9fs\n' > hello.txt
+head -c 3000000 /dev/urandom > big.bin
+ln -s hello.txt link
+ln -s sub/missing dangling
+printf 'deep\n' > sub/deep.txt
+mkfifo fifo
+for i in $(seq 1 600); do
+  echo "$i" > "many/file_with_a_reasonably_long_name_$i"
+done
+chmod 0600 sub/deep.txt
+chmod 0750 sub
+echo "r9fs: export at $share ($(find "$share" | wc -l) entries)"
diff --git a/scripts/v9fs-r9fs-tests b/scripts/v9fs-r9fs-tests
new file mode 100755
index 0000000..49b70da
--- /dev/null
+++ b/scripts/v9fs-r9fs-tests
@@ -0,0 +1,157 @@
+#!/usr/bin/env bash
+# r9fs suite: runs inside the guest chroot (whose root is the C v9fs hostshare mount).
+#
+# QEMU exports the same host directory on two extra virtio-9p devices:
+#   r9share  - unthrottled; differential and negative checks
+#   r9slow   - read-throttled (qemu.bash R9FS_SLOW_BPS); kill and unbind checks
+# At boot the built-in C 9pnet_virtio driver binds every virtio-9p device; this suite moves
+# r9share and r9slow to r9fs_virtio. The reference for the differential is the C v9fs view of
+# the same host directory through hostshare.
+set -uo pipefail
+
+tmp="${R9FS_TMP:-/workspaces/tmp/r9fs}"
+share="${R9FS_SHARE:-/workspaces/tmp/r9fs-share}"
+logs="/home/v9fs-test/test/logs"
+work="/workspaces/tmpdir/r9fs"
+kmod="$tmp/v9fs-kmod"
+mkdir -p "$logs" "$work"
+rm -rf "${work:?}"/*
+
+fail=0
+pass() { echo "PASS $1"; }
+bad() { echo "FAIL $1${2:+: $2}"; fail=1; }
+check() { local n="$1"; shift; if "$@"; then pass "$n"; else bad "$n"; fi; }
+require() { check "$@" || { echo "r9fs: cannot continue after $1"; exit 1; }; }
+now_ms() { awk '{print int($1 * 1000)}' /proc/uptime; }
+pstate() { awk '{print $3}' "/proc/$1/stat" 2>/dev/null; }
+errno_of() { # run a command, print its stderr (for EROFS/ENOENT/... matching)
+  "$@" 2>&1 >/dev/null
+}
+mount_errno() { # mount(2) directly: util-linux rewrites errnos into its own messages
+  python3 - "$@" <<'PY'
+import ctypes, errno, os, sys
+src, tgt, opts = sys.argv[1], sys.argv[2], (sys.argv[3] if len(sys.argv) > 3 else "")
+libc = ctypes.CDLL(None, use_errno=True)
+rc = libc.mount(src.encode(), tgt.encode(), b"r9fs", 0, opts.encode())
+print("OK" if rc == 0 else errno.errorcode[ctypes.get_errno()])
+PY
+}
+
+declare -A dev_of
+for d in /sys/bus/virtio/devices/virtio*; do
+  tag="$(tr -d '\0' < "$d/mount_tag" 2>/dev/null || true)"
+  case "$tag" in r9share|r9slow) dev_of[$tag]="$(basename "$d")" ;; esac
+done
+echo "r9fs: devices r9share=${dev_of[r9share]:-none} r9slow=${dev_of[r9slow]:-none}"
+if [ -z "${dev_of[r9share]:-}" ] || [ -z "${dev_of[r9slow]:-}" ]; then
+  bad devices "qemu.bash did not provide r9share/r9slow (R9FS_SHARE unset?)"
+  exit 1
+fi
+
+require load "$kmod" load "$tmp/r9fs.ko"
+require registered grep -qw r9fs /proc/filesystems
+
+for tag in r9share r9slow; do
+  dev="${dev_of[$tag]}"
+  if [ -e "/sys/bus/virtio/devices/$dev/driver" ]; then
+    echo "$dev" > "/sys/bus/virtio/devices/$dev/driver/unbind"
+  fi
+  echo "$dev" > /sys/bus/virtio/drivers/r9fs_virtio/bind
+  drv="$(basename "$(readlink "/sys/bus/virtio/devices/$dev/driver")")"
+  require "bind-$tag" [ "$drv" = r9fs_virtio ]
+done
+
+# --- differential against C v9fs -------------------------------------------------------------
+manifest() {
+  (cd "$1" && find . -mindepth 1 | LC_ALL=C sort | while IFS= read -r f; do
+    meta="$(stat -c '%F %a %h %u %g %i' -- "$f")"
+    if [ -L "$f" ]; then
+      echo "$f | $meta | -> $(readlink -- "$f")"
+    elif [ -f "$f" ]; then
+      echo "$f | $meta $(stat -c '%s %Y' -- "$f") | $(sha256sum < "$f" | cut -c1-64)"
+    else
+      echo "$f | $meta"
+    fi
+  done)
+}
+
+r9="$work/mnt"
+mkdir -p "$r9"
+require mount mount -t r9fs -o msize=131072 r9share "$r9"
+grep " $r9 " /proc/mounts
+
+manifest "$share" > "$work/ref.manifest"
+manifest "$r9" > "$work/r9fs.manifest"
+cp -f "$work/ref.manifest" "$work/r9fs.manifest" "$logs/" 2>/dev/null || true
+rows="$(wc -l < "$work/ref.manifest")"
+echo "r9fs: manifest rows ref=$rows r9fs=$(wc -l < "$work/r9fs.manifest")"
+if [ "$rows" -ge 600 ] && diff -u "$work/ref.manifest" "$work/r9fs.manifest" > "$work/manifest.diff"; then
+  pass manifest-vs-v9fs
+else
+  bad manifest-vs-v9fs "$(head -c 2000 "$work/manifest.diff")"
+fi
+ref_df="$(stat -f -c '%b %f %a %S' "$share")"
+r9_df="$(stat -f -c '%b %f %a %S' "$r9")"
+echo "r9fs: statfs ref=[$ref_df] r9fs=[$r9_df]"
+# QEMU scales f_bsize with the negotiated msize, so compare capacity in bytes (one block of slack).
+ref_bytes=$(( $(stat -f -c '%S * %b' "$share") ))
+r9_bytes=$(( $(stat -f -c '%S * %b' "$r9") ))
+slack=$(( $(stat -f -c %S "$share") > $(stat -f -c %S "$r9") ? $(stat -f -c %S "$share") : $(stat -f -c %S "$r9") ))
+d=$(( ref_bytes > r9_bytes ? ref_bytes - r9_bytes : r9_bytes - ref_bytes ))
+[ "$d" -le "$slack" ] && pass statfs || bad statfs "ref=$ref_bytes r9fs=$r9_bytes"
+
+# --- negative / read-only checks -------------------------------------------------------------
+mkdir -p "$work/x"
+e="$(mount_errno nosuchtag "$work/x")"; [ "$e" = ENOENT ] && pass bad-tag || bad bad-tag "$e"
+e="$(mount_errno r9share "$work/x" bogus=1)"; [ "$e" = EINVAL ] && pass bad-option || bad bad-option "$e"
+e="$(mount_errno r9share "$work/x")"; [ "$e" = EBUSY ] && pass busy-tag || bad busy-tag "$e"
+e="$(errno_of touch "$r9/new")"; [[ "$e" == *"Read-only"* ]] && pass erofs-create || bad erofs-create "$e"
+e="$(errno_of mkdir "$r9/d")"; [[ "$e" == *"Read-only"* ]] && pass erofs-mkdir || bad erofs-mkdir "$e"
+mount -o remount,rw "$r9" 2>/dev/null
+grep " $r9 " /proc/mounts | grep -q ' ro[ ,]' && pass remount-stays-ro || bad remount-stays-ro
+e="$(errno_of chmod 600 "$r9/hello.txt")"; [[ "$e" == *"Read-only"* ]] && pass erofs-chmod || bad erofs-chmod "$e"
+
+ref_sum="$(sha256sum < "$share/big.bin")"
+for i in 1 2 3 4 5 6 7 8; do sha256sum < "$r9/big.bin" > "$work/par.$i" & done
+wait
+[ "$(cat "$work"/par.* | sort -u)" = "$ref_sum" ] && pass parallel-read || bad parallel-read
+
+check umount umount "$r9"
+check remount mount -t r9fs r9share "$r9"
+[ "$(cat "$r9/sub/deep.txt")" = deep ] && pass reread || bad reread
+
+# --- stalled server: kill (r9slow) -----------------------------------------------------------
+slow="$work/slow"
+mkdir -p "$slow"
+require mount-slow mount -t r9fs -o msize=65536 r9slow "$slow"
+# One read(2) per Tread (bs < msize), so exactly one request is posted when the reader is killed.
+dd if="$slow/big.bin" of=/dev/null bs=4096 2>/dev/null & A=$!
+sleep 2
+st="$(pstate $A)"
+echo "r9fs: stalled reader state=$st"
+t0="$(now_ms)"; kill -9 "$A"; wait "$A" 2>/dev/null; t1="$(now_ms)"
+lat=$((t1 - t0))
+echo "r9fs: kill latency ${lat} ms (limit ${R9FS_KILL_MS:-1000})"
+[ "$st" = D ] && [ "$lat" -lt "${R9FS_KILL_MS:-1000}" ] && pass kill-stalled-reader || bad kill-stalled-reader "state=$st ${lat} ms"
+# The next request reaps the abandoned reply first and must get its own reply.
+[ "$(cat "$slow/hello.txt")" = "hello r9fs" ] && pass reply-after-kill || bad reply-after-kill
+
+# --- device removal during a posted request (r9slow) -----------------------------------------
+dd if="$slow/big.bin" of="$work/out" bs=4096 2>"$work/dd.err" & A=$!
+sleep 2
+st="$(pstate $A)"
+s1="$(stat -c %s "$work/out")"
+echo "${dev_of[r9slow]}" > /sys/bus/virtio/drivers/r9fs_virtio/unbind
+wait "$A"; rc=$?
+s2="$(stat -c %s "$work/out")"
+echo "r9fs: unbind reader_state=$st reader_rc=$rc bytes_before=$s1 bytes_after=$s2 ($(cat "$work/dd.err"))"
+# An uninterruptible transport waits for the posted reply and delivers it (s2 = s1 + 4096).
+[ "$st" = D ] && [ "$rc" -ne 0 ] && [ "$s2" -eq "$s1" ] && pass unbind-fails-posted-read || bad unbind-fails-posted-read
+e="$(errno_of ls "$slow")"; [[ "$e" == *"Input/output"* ]] && pass eio-after-unbind || bad eio-after-unbind "$e"
+check umount-slow umount "$slow"
+
+check umount-final umount "$r9"
+check unload "$kmod" unload r9fs
+
+echo "r9fs: done fail=$fail"
+exit "$fail"
