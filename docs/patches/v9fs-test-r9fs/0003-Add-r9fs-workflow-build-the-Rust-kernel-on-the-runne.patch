 CHANGES.md                          |  1 +
 README.md                           |  2 +-
 TODO.md                             |  2 +-
 scripts/v9fs-install-rust-toolchain | 31 +++++++++++
 scripts/v9fs-prepare-r9fs           |  7 +--
 scripts/v9fs-run-tests              |  3 ++
 7 files changed, 120 insertions(+), 5 deletions(-)
 create mode 100644 .github/workflows/r9fs.yml
