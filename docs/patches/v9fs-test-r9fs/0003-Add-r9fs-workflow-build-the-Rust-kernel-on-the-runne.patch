diff --git a/.github/workflows/r9fs.yml b/.github/workflows/r9fs.yml
new file mode 100644
index 0000000..c1c9158
--- /dev/null
+++ b/.github/workflows/r9fs.yml
@@ -0,0 +1,79 @@
+name: r9fs suite (Rust kernel build + test)
+
+# r9fs (fs/r9fs, Rust) is not part of the published Image line: it needs CONFIG_RUST and a
+# loadable r9fs.ko built from the same commit as the Image, and ghcr.io/v9fs/docker has no
+# Rust toolchain. This workflow builds both on the runner and runs the `r9fs` suite with the
+# same container and scripts as Harness CI.
+
+on:
+  workflow_dispatch:
+    inputs:
+      linux_repository:
+        description: "Kernel repository"
+        required: true
+        default: "v9fs/linux"
+        type: string
+      linux_ref:
+        description: "Kernel ref carrying fs/r9fs"
+        required: true
+        default: "cursor/r9fs-rust-virtio-f6e3"
+        type: string
+
+permissions:
+  contents: read
+
+jobs:
+  r9fs:
+    runs-on: ubuntu-24.04-arm
+    timeout-minutes: 180
+    env:
+      V9FS_DOCKER_IMAGE: ghcr.io/v9fs/docker:latest
+    steps:
+      - name: Checkout harness
+        uses: actions/checkout@v7
+
+      - name: Checkout kernel
+        uses: actions/checkout@v7
+        with:
+          repository: ${{ inputs.linux_repository }}
+          ref: ${{ inputs.linux_ref }}
+          path: linux
+
+      - name: Install Rust kernel toolchain
+        run: ./scripts/v9fs-install-rust-toolchain
+
+      - name: Build arm64 Image + r9fs.ko
+        run: ./scripts/v9fs-build-r9fs-kernel "$GITHUB_WORKSPACE/linux" "$GITHUB_WORKSPACE/kernel/.build"
+
+      - name: Run r9fs (guest-direct, chroot)
+        run: |
+          mkdir -p "$GITHUB_WORKSPACE/tmp"
+          docker run --rm --privileged \
+            --name "v9fs-test.r9fs.${{ github.run_id }}.${{ github.run_attempt }}" \
+            --label v9fs.harness=v9fs-test \
+            --user 0:0 \
+            -e KERNELBUILD=/workspaces/kernel/.build \
+            -v "$GITHUB_WORKSPACE:/home/v9fs-test/test" \
+            -v "$GITHUB_WORKSPACE/kernel:/workspaces/kernel" \
+            -v "$GITHUB_WORKSPACE/tmp:/workspaces/tmp" \
+            -w /home/v9fs-test/test \
+            "${V9FS_DOCKER_IMAGE}" \
+            bash -lc "./scripts/v9fs-run-tests r9fs"
+
+      - name: Dump logs on failure
+        if: failure()
+        run: |
+          for f in logs/*/r9fs.log logs/*/klog.json; do echo "---- $f"; cat "$f" || true; done
+          for f in logs/*/qemu.log; do echo "---- $f"; tail -n 250 "$f" || true; done
+
+      - name: Fix log permissions (for artifact upload)
+        if: always()
+        run: sudo chmod -R a+rX logs || true
+
+      - name: Upload logs
+        if: always()
+        uses: actions/upload-artifact@v7
+        with:
+          name: r9fs-logs
+          path: logs
+          retention-days: 7
