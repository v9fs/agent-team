diff --git a/scripts/v9fs-install-rust-toolchain b/scripts/v9fs-install-rust-toolchain
new file mode 100755
index 0000000..c0dffa7
--- /dev/null
+++ b/scripts/v9fs-install-rust-toolchain
@@ -0,0 +1,31 @@
+#!/usr/bin/env bash
+# Install the toolchain scripts/v9fs-build-r9fs-kernel needs on an Ubuntu runner:
+# clang/lld (LLVM=1), rustc with rust-src, and bindgen. ghcr.io/v9fs/docker has none of them.
+#
+# Versions match the recorded r9fs runs; override with RUST_VERSION / BINDGEN_VERSION.
+set -euo pipefail
+
+RUST_VERSION="${RUST_VERSION:-1.99.0}"
+BINDGEN_VERSION="${BINDGEN_VERSION:-0.73.2}"
+
+sudo apt-get update -q
+sudo apt-get install -y -q --no-install-recommends \
+  clang lld llvm libclang-dev bc bison flex libelf-dev libssl-dev make cpio
+
+if ! command -v rustup >/dev/null 2>&1; then
+  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs |
+    sh -s -- -y --profile minimal --default-toolchain none
+fi
+export PATH="$HOME/.cargo/bin:$PATH"
+rustup toolchain install "$RUST_VERSION" --profile minimal --component rust-src
+rustup default "$RUST_VERSION"
+if [ "$(bindgen --version 2>/dev/null)" != "bindgen $BINDGEN_VERSION" ]; then
+  cargo install --locked --version "$BINDGEN_VERSION" bindgen-cli
+fi
+
+if [ -n "${GITHUB_PATH:-}" ]; then
+  echo "$HOME/.cargo/bin" >> "$GITHUB_PATH"
+fi
+rustc --version
+bindgen --version
+clang --version | head -1
diff --git a/scripts/v9fs-prepare-r9fs b/scripts/v9fs-prepare-r9fs
index 12c0e7e..0c4aa28 100755
--- a/scripts/v9fs-prepare-r9fs
+++ b/scripts/v9fs-prepare-r9fs
@@ -2,11 +2,12 @@
 # Host-side (container) preparation for the r9fs suite.
 #
 # - builds the v9fs-kmod module loader (the Debian chroot has no kmod);
-# - stages r9fs.ko from KERNELBUILD so the guest can load it;
+# - stages r9fs.ko (R9FS_KO, default from KERNELBUILD) so the guest can load it;
 # - creates the export that QEMU serves on tags r9share and r9slow.
 #
 # The kernel under test must be built with CONFIG_RUST=y and CONFIG_R9FS_FS=m
-# (scripts/v9fs-build-r9fs-kernel).
+# (scripts/v9fs-build-r9fs-kernel). R9FS_KO must come from the same kernel commit as the
+# Image: the commit is part of the vermagic.
 set -euo pipefail
 
 script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
@@ -14,7 +15,7 @@ KERNELBUILD="${KERNELBUILD:-/workspaces/kernel/.build}"
 out="${R9FS_TMP:-/workspaces/tmp/r9fs}"
 share="${R9FS_SHARE:-/workspaces/tmp/r9fs-share}"
 
-ko="${KERNELBUILD}/fs/r9fs/r9fs.ko"
+ko="${R9FS_KO:-${KERNELBUILD}/fs/r9fs/r9fs.ko}"
 if [ ! -f "$ko" ]; then
   echo "ERROR: $ko not found; build the kernel with scripts/v9fs-build-r9fs-kernel"
   exit 2
